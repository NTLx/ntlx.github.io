---
const { posts = [] } = Astro.props;

const categoryLabels = {
  'ai-coding': 'AI 编程实践',
  'ai-agents': 'Agent 与工具链',
  'ai-industry': 'AI 行业洞察',
  'ai-models': '模型与研究',
  security: '安全',
  engineering: '工程案例',
};

const fmtDate = (d) => {
  const date = new Date(d);
  return `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, '0')}-${String(date.getUTCDate()).padStart(2, '0')}`;
};

const years = [...new Set(
  posts
    .map((post) => post.data.date?.getUTCFullYear())
    .filter(Boolean),
)].sort((a, b) => b - a);
---

<div class="archive-explorer" data-archive-explorer>
  <div class="filters" role="search" aria-label="筛选文章" data-filters hidden>
    <label class="search-field">
      <span class="sr-label">搜索文章</span>
      <input type="search" placeholder="搜索标题或标签…" autocomplete="off" data-filter-query />
    </label>

    <label>
      <span class="sr-label">专题</span>
      <select data-filter-category>
        <option value="">全部专题</option>
        {Object.entries(categoryLabels).map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </select>
    </label>

    <label>
      <span class="sr-label">年份</span>
      <select data-filter-year>
        <option value="">全部年份</option>
        {years.map((year) => <option value={String(year)}>{year}</option>)}
      </select>
    </label>
  </div>

  <div class="result-summary" aria-live="polite">
    显示 <strong data-result-count>{posts.length}</strong> / {posts.length} 篇
    <button type="button" data-filter-reset hidden>清除筛选</button>
  </div>

  <ul class="article-list" data-article-list>
    {posts.map((post) => {
      const year = post.data.date?.getUTCFullYear();
      const searchText = [
        post.data.title,
        ...(post.data.tags ?? []),
      ].join(' ').toLocaleLowerCase('zh-CN');

      return (
        <li
          data-article-item
          data-category={post.data.category}
          data-year={year}
          data-search={searchText}
        >
          <a class="article-link" href={`/${post.id}/`}>
            <div class="article-meta">
              <time datetime={fmtDate(post.data.date)}>{fmtDate(post.data.date)}</time>
              <span>{categoryLabels[post.data.category] ?? post.data.category}</span>
            </div>
            <strong>{post.data.title}</strong>
          </a>
        </li>
      );
    })}
  </ul>

  <p class="empty-state" data-empty-state hidden>没有匹配的文章。可以清除筛选或换一个关键词。</p>
  <noscript><p class="noscript-note">筛选功能需要 JavaScript；当前已完整显示全部文章。</p></noscript>
</div>

<script>
  const explorers = document.querySelectorAll('[data-archive-explorer]');

  explorers.forEach((root) => {
    const filters = root.querySelector('[data-filters]');
    if (filters instanceof HTMLElement) filters.hidden = false;

    const queryInput = root.querySelector('[data-filter-query]');
    const categorySelect = root.querySelector('[data-filter-category]');
    const yearSelect = root.querySelector('[data-filter-year]');
    const resetButton = root.querySelector('[data-filter-reset]');
    const count = root.querySelector('[data-result-count]');
    const empty = root.querySelector('[data-empty-state]');
    const items = [...root.querySelectorAll('[data-article-item]')];

    if (!(queryInput instanceof HTMLInputElement) ||
        !(categorySelect instanceof HTMLSelectElement) ||
        !(yearSelect instanceof HTMLSelectElement) ||
        !(resetButton instanceof HTMLButtonElement)) return;

    const applyFilters = () => {
      const query = queryInput.value.trim().toLocaleLowerCase('zh-CN');
      const category = categorySelect.value;
      const year = yearSelect.value;
      let visible = 0;

      for (const item of items) {
        if (!(item instanceof HTMLElement)) continue;
        const matchesQuery = !query || (item.dataset.search ?? '').includes(query);
        const matchesCategory = !category || item.dataset.category === category;
        const matchesYear = !year || item.dataset.year === year;
        const show = matchesQuery && matchesCategory && matchesYear;
        item.hidden = !show;
        if (show) visible += 1;
      }

      if (count) count.textContent = String(visible);
      if (empty instanceof HTMLElement) empty.hidden = visible !== 0;
      resetButton.hidden = !query && !category && !year;
    };

    queryInput.addEventListener('input', applyFilters);
    categorySelect.addEventListener('change', applyFilters);
    yearSelect.addEventListener('change', applyFilters);
    resetButton.addEventListener('click', () => {
      queryInput.value = '';
      categorySelect.value = '';
      yearSelect.value = '';
      applyFilters();
      queryInput.focus();
    });
  });
</script>

<style>
  .archive-explorer {
    margin-top: 1.5rem;
  }

  .filters {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) auto auto;
    gap: 0.65rem;
    align-items: center;
    margin-bottom: 0.65rem;
  }

  .filters input,
  .filters select {
    width: 100%;
    min-height: 2.55rem;
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font: inherit;
  }

  .filters input:focus,
  .filters select:focus {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }

  .sr-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .result-summary {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    margin-bottom: 1rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .result-summary button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--sl-color-accent-high);
    font: inherit;
    cursor: pointer;
  }

  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .article-list li {
    margin: 0;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .article-link {
    display: block;
    padding: 1rem 0.15rem 1.05rem;
    color: inherit;
    text-decoration: none;
  }

  .article-link:hover strong {
    color: var(--sl-color-accent-high);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  .article-link strong {
    display: block;
    color: var(--sl-color-white);
    font-size: var(--sl-text-base);
    line-height: 1.45;
  }

  .empty-state {
    padding: 2rem 0;
    color: var(--sl-color-gray-3);
    text-align: center;
  }

  .noscript-note {
    margin-top: 1rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  @media (max-width: 50rem) {
    .filters {
      grid-template-columns: 1fr 1fr;
    }

    .search-field {
      grid-column: 1 / -1;
    }
  }
</style>
