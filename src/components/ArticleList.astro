---
const { posts = [], showCategory = true, showDescription = true } = Astro.props;

const categoryLabels = {
  'ai-coding': 'AI 编程实践',
  'ai-agents': 'Agent 与工具链',
  'ai-industry': 'AI 行业洞察',
  'ai-models': '模型与研究',
  security: '安全',
  engineering: '工程案例',
};

const fmtDate = (d) => {
  if (!d) return '';
  const date = new Date(d);
  return `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, '0')}-${String(date.getUTCDate()).padStart(2, '0')}`;
};
---

<ul class="article-list">
  {posts.map((post) => (
    <li>
      <a class="article-link" href={`/${post.id}/`}>
        <div class="article-meta">
          {post.data.date && <time datetime={fmtDate(post.data.date)}>{fmtDate(post.data.date)}</time>}
          {showCategory && post.data.category && (
            <span>{categoryLabels[post.data.category] ?? post.data.category}</span>
          )}
        </div>
        <strong>{post.data.title}</strong>
        {showDescription && post.data.description && <p>{post.data.description}</p>}
      </a>
    </li>
  ))}
</ul>

<style>
  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .article-list li {
    margin: 0;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .article-link {
    display: block;
    padding: 1.15rem 0.15rem 1.2rem;
    color: inherit;
    text-decoration: none;
  }

  .article-link:hover strong {
    color: var(--sl-color-accent-high);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
  }

  strong {
    display: block;
    color: var(--sl-color-white);
    font-size: var(--sl-text-lg);
    line-height: 1.45;
  }

  p {
    margin: 0.4rem 0 0;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    line-height: 1.65;
  }
</style>
