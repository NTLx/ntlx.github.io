---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

const pathname = Astro.url.pathname;
const navItems = [
  { label: '文章', href: '/archive/', active: pathname === '/archive/' || pathname.startsWith('/articles/') },
  { label: '专题', href: '/topics/', active: pathname === '/topics/' },
  { label: '技术笔记', href: '/notes/', active: pathname === '/notes/' },
  { label: '关于', href: '/about/', active: pathname === '/about/' },
];
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>

  <nav class="primary-nav sl-hidden md:sl-flex print:hidden" aria-label="主导航">
    {navItems.map((item) => (
      <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
    ))}
  </nav>

  <div class="actions sl-flex print:hidden">
    <Search />
    <div class="sl-hidden md:sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <details class="mobile-nav md:sl-hidden">
      <summary aria-label="打开导航">导航</summary>
      <nav aria-label="移动端主导航">
        {navItems.map((item) => (
          <a href={item.href} aria-current={item.active ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </details>
  </div>
</div>

<style>
  @layer starlight.core {
    .header {
      display: grid;
      grid-template-columns: minmax(0, auto) 1fr auto;
      gap: 1rem;
      align-items: center;
      height: 100%;
    }

    .title-wrapper {
      overflow: clip;
      min-width: 0;
      padding: 0.25rem;
      margin: -0.25rem;
    }

    .primary-nav {
      justify-content: center;
      gap: 0.15rem;
      min-width: 0;
    }

    .primary-nav a {
      padding: 0.45rem 0.65rem;
      border-radius: 0.45rem;
      color: var(--sl-color-gray-2);
      text-decoration: none;
      font-size: var(--sl-text-sm);
      white-space: nowrap;
    }

    .primary-nav a:hover,
    .primary-nav a[aria-current='page'] {
      color: var(--sl-color-white);
      background: var(--sl-color-gray-6);
    }

    .actions,
    .social-icons {
      align-items: center;
      gap: 0.7rem;
    }

    .mobile-nav {
      position: relative;
    }

    .mobile-nav summary {
      cursor: pointer;
      list-style: none;
      padding: 0.4rem 0.55rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.45rem;
      color: var(--sl-color-gray-2);
      font-size: var(--sl-text-xs);
      user-select: none;
    }

    .mobile-nav summary::-webkit-details-marker {
      display: none;
    }

    .mobile-nav nav {
      position: absolute;
      z-index: calc(var(--sl-z-index-navbar) + 1);
      inset-inline-end: 0;
      top: calc(100% + 0.55rem);
      display: grid;
      min-width: 9.5rem;
      padding: 0.45rem;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.65rem;
      background: var(--sl-color-bg-nav);
      box-shadow: var(--sl-shadow-md);
    }

    .mobile-nav nav a {
      padding: 0.6rem 0.7rem;
      border-radius: 0.4rem;
      color: var(--sl-color-gray-2);
      text-decoration: none;
      font-size: var(--sl-text-sm);
    }

    .mobile-nav nav a:hover,
    .mobile-nav nav a[aria-current='page'] {
      color: var(--sl-color-white);
      background: var(--sl-color-gray-6);
    }

    .social-icons::before {
      content: '';
      height: 1.75rem;
      border-inline-start: 1px solid var(--sl-color-gray-5);
    }

    @media (max-width: 72rem) {
      .primary-nav a {
        padding-inline: 0.45rem;
      }
    }
  }
</style>
