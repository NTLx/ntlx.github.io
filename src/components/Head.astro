---
// 覆盖 Starlight 默认 Head 组件，在保留全部默认 head 标签的基础上：
// 1. 按页注入 og:image（文章取正文首图 CDN URL，缺图/非文章页回退站点默认 og-image.png）
// 2. 为文章页注入 BlogPosting JSON-LD 结构化数据
// 文档：https://starlight.astro.build/guides/overriding-components/
const { head, entry } = Astro.locals.starlightRoute;

const site = Astro.site ?? new URL('https://ntlx.github.io/');
const defaultOgImage = new URL('/og-image.png', site).toString();

let ogImage = defaultOgImage;
const categoryLabels = {
	'ai-coding': 'AI 编程实践',
	'ai-agents': 'Agent 与工具链',
	'ai-industry': 'AI 行业洞察',
	'ai-models': '模型与研究',
	security: '安全',
	engineering: '工程案例',
};
const isArticle = Boolean(
	entry &&
	entry.id.startsWith('articles/') &&
	entry.data?.date &&
	entry.data?.category
);

if (isArticle) {
	const body = entry.body ?? '';
	// 提取正文第一张 Markdown 图片：![alt](url) 或 ![alt](url "title")
	const m = body.match(/!\[[^\]]*\]\(([^)\s]+)(?:\s+"[^"]*")?\)/);
	if (m) {
		const src = m[1];
		ogImage = src.startsWith('http') ? src : new URL(src, site).toString();
	}
}

// 过滤掉全局 head 里注入的 og:image，避免出现两个 og:image meta（爬虫取值不一致）
const filteredHead = head.filter(
	(h) => !(h.tag === 'meta' && h.attrs && h.attrs.property === 'og:image')
);

// 文章页构造 BlogPosting 结构化数据
let jsonLd = null;
if (isArticle && entry.data) {
	const d = entry.data;
	const url = new URL(`/${entry.id}/`, site).toString();
	const datePublished = d.date ? new Date(d.date).toISOString() : undefined;
	const dateModifiedRaw = d.updated ?? d.date;
	const dateModified = dateModifiedRaw ? new Date(dateModifiedRaw).toISOString() : undefined;
	jsonLd = {
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		headline: d.title,
		description: d.description,
		image: [ogImage],
		...(d.category ? { articleSection: categoryLabels[d.category] ?? d.category } : {}),
		...(d.tags?.length ? { keywords: d.tags } : {}),
		...(datePublished ? { datePublished } : {}),
		...(dateModified ? { dateModified } : {}),
		author: {
			'@type': 'Person',
			name: 'NTLx',
			url: site.toString(),
		},
		publisher: {
			'@type': 'Organization',
			name: "NTLx's Blog",
			logo: {
				'@type': 'ImageObject',
				url: new URL('/favicon.svg', site).toString(),
			},
		},
		mainEntityOfPage: { '@type': 'WebPage', '@id': url },
		url,
	};
}
---

{
	/* 渲染 Starlight 默认 head（已剔除全局 og:image） */
	filteredHead.map(({ tag: Tag, attrs, content }) => (
		<Tag {...attrs} set:html={content} />
	))
}

{/* 按页分享图片，覆盖默认值 */}
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={entry?.data?.title ?? "NTLx's Blog"} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={entry?.data?.title ?? "NTLx's Blog"} />

{isArticle && entry.data?.date && (
	<meta property="article:published_time" content={new Date(entry.data.date).toISOString()} />
)}
{isArticle && (entry.data?.updated ?? entry.data?.date) && (
	<meta
		property="article:modified_time"
		content={new Date(entry.data.updated ?? entry.data.date).toISOString()}
	/>
)}
{isArticle && entry.data?.category && (
	<meta
		property="article:section"
		content={categoryLabels[entry.data.category] ?? entry.data.category}
	/>
)}
{isArticle && entry.data?.tags?.map((tag) => (
	<meta property="article:tag" content={tag} />
))}

{/* 文章页 BlogPosting 结构化数据 */}
{
	jsonLd && (
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	)
}

<script is:inline>
(() => {
  const track = (name, params = {}) => {
    if (typeof window.gtag === 'function') {
      window.gtag('event', name, params);
    }
  };

  const linkContext = (anchor) => {
    if (anchor.closest('.related')) return 'related_articles';
    if (anchor.closest('.article-list')) return 'article_list';
    if (anchor.closest('.topic-grid')) return 'topic_overview';
    if (anchor.closest('.primary-nav')) return 'primary_nav';
    if (anchor.closest('.blog-sidebar')) return 'blog_sidebar';
    if (anchor.closest('.site-footer, .article-footer')) return 'footer';
    return 'content';
  };

  document.addEventListener('blog:archive-filter', (event) => {
    const detail = event.detail ?? {};
    track('archive_filter', {
      page_path: location.pathname,
      filter_type: detail.filter_type,
      filter_value: detail.filter_value,
      query_length: detail.query_length,
      result_count: detail.result_count,
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const searchButton = target.closest('site-search [data-open-modal]');
    if (searchButton) {
      track('blog_search_open', { page_path: location.pathname });
      return;
    }

    const copyButton = target.closest('.expressive-code .copy button[data-code]');
    if (copyButton instanceof HTMLButtonElement) {
      const pre = copyButton.closest('figure')?.querySelector('pre[data-language]');
      track('copy_code', {
        page_path: location.pathname,
        code_language: pre?.getAttribute('data-language') ?? 'unknown',
        code_length: (copyButton.dataset.code ?? '').length,
      });
      return;
    }

    const anchor = target.closest('a[href]');
    if (!(anchor instanceof HTMLAnchorElement)) return;

    let url;
    try {
      url = new URL(anchor.href, location.href);
    } catch {
      return;
    }

    if (url.origin !== location.origin) return;

    if (url.pathname === '/rss.xml') {
      track('rss_click', {
        page_path: location.pathname,
        link_context: linkContext(anchor),
      });
      return;
    }

    if (url.pathname.startsWith('/articles/') && url.pathname !== location.pathname) {
      track('internal_article_click', {
        page_path: location.pathname,
        destination_path: url.pathname,
        link_context: linkContext(anchor),
      });
    }
  });
})();
</script>
