{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wechat-article-write image-plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["visual_profile", "source_image_policy", "article_visual_design", "cover", "infographic", "illustrations", "source_image_review"],
  "properties": {
    "visual_profile": {
      "type": "string",
      "enum": ["bright-vivid-warm", "custom"],
      "default": "bright-vivid-warm"
    },
    "visual_override_reason": { "type": "string", "minLength": 1 },
    "source_image_policy": {
      "type": "string",
      "enum": ["prefer-reuse", "neutral", "no-reuse"],
      "default": "prefer-reuse"
    },
    "article_type": { "type": "string", "minLength": 1 },
    "direction": { "type": "string", "minLength": 1 },
    "visual_language": { "type": "object", "additionalProperties": true },
    "article_visual_design": {
      "type": "object",
      "additionalProperties": true,
      "required": ["planner", "coverage_review"],
      "properties": {
        "planner": { "const": "wechat-article-write-agent" },
        "strategy": { "type": "string", "minLength": 1 },
        "coverage_review": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["section_index", "heading", "decision", "reason"],
            "properties": {
              "section_index": { "type": "integer", "minimum": 1 },
              "heading": { "type": "string", "minLength": 1 },
              "decision": { "type": "string", "enum": ["illustrate", "reuse-source", "text-only"] },
              "slot": { "type": "integer", "minimum": 1 },
              "source": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            },
            "allOf": [
              { "if": { "properties": { "decision": { "const": "illustrate" } }, "required": ["decision"] }, "then": { "required": ["slot"] } },
              { "if": { "properties": { "decision": { "const": "reuse-source" } }, "required": ["decision"] }, "then": { "required": ["source"] } }
            ]
          }
        }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": true,
      "required": ["producer", "baoyu_design", "prompt_source", "intent"],
      "properties": {
        "producer": { "const": "baoyu-cover-image" },
        "intent": { "type": "string", "minLength": 1 },
        "prompt_source": { "const": "external" },
        "baoyu_design": {
          "type": "object",
          "additionalProperties": true,
          "required": ["skill", "aspect", "text"],
          "properties": {
            "skill": { "const": "baoyu-cover-image" },
            "aspect": { "const": "2.35:1" },
            "text": { "const": "none" }
          }
        }
      }
    },
    "infographic": {
      "type": "object",
      "additionalProperties": true,
      "required": ["producer", "baoyu_design", "prompt_source", "intent", "text_density", "has_long_copy"],
      "properties": {
        "producer": { "const": "baoyu-xhs-images" },
        "intent": { "type": "string", "minLength": 1 },
        "prompt_source": { "const": "external" },
        "text_density": { "const": "low" },
        "has_long_copy": { "const": false },
        "baoyu_design": {
          "type": "object",
          "additionalProperties": true,
          "required": ["skill", "card_count"],
          "properties": {
            "skill": { "const": "baoyu-xhs-images" },
            "card_count": { "const": 1 }
          }
        }
      }
    },
    "illustrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["slot", "producer", "intent", "baoyu_design", "prompt_source", "text_density", "has_long_copy"],
        "properties": {
          "slot": { "type": "integer", "minimum": 1 },
          "producer": { "const": "baoyu-infographic" },
          "intent": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "prompt_source": { "const": "external" },
          "text_density": { "enum": ["low", "medium"] },
          "has_long_copy": { "const": false },
          "baoyu_design": {
            "type": "object",
            "additionalProperties": true,
            "required": ["skill"],
            "properties": { "skill": { "const": "baoyu-infographic" } }
          }
        }
      }
    },
    "source_image_review": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "reusable", "decision", "reason"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "reusable": { "type": "boolean" },
          "decision": { "type": "string", "enum": ["cover-only", "body", "both", "discard"] },
          "reason": { "type": "string", "minLength": 1 },
          "exception_code": { "type": "string", "enum": ["irrelevant", "duplicate", "redundant", "low-quality", "unreadable", "legal-risk", "incompatible"] }
        },
        "allOf": [
          {
            "if": {
              "properties": { "reusable": { "const": true }, "decision": { "enum": ["cover-only", "discard"] } },
              "required": ["reusable", "decision"]
            },
            "then": { "required": ["exception_code"] }
          },
          {
            "if": {
              "properties": { "reusable": { "const": false }, "decision": { "enum": ["body", "both"] } },
              "required": ["reusable", "decision"]
            },
            "then": false
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "visual_profile": { "const": "custom" } }, "required": ["visual_profile"] },
      "then": { "required": ["visual_override_reason"] }
    }
  ]
}
