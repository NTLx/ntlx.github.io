{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wechat-article-write image-plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["article_visual_design", "cover", "infographic", "illustrations"],
  "properties": {
    "article_type": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "type": "string",
      "minLength": 1
    },
    "visual_language": {
      "type": "object",
      "additionalProperties": true
    },
    "article_visual_design": {
      "type": "object",
      "additionalProperties": true,
      "required": ["skill"],
      "properties": {
        "skill": { "const": "baoyu-article-illustrator" },
        "strategy": { "type": "string", "minLength": 1 }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "intent": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "style": { "type": "string", "minLength": 1 },
        "palette": { "type": "string", "minLength": 1 },
        "rendering": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "mood": { "type": "string", "minLength": 1 },
        "baoyu_design": {
          "type": "object",
          "additionalProperties": true,
          "required": ["skill"],
          "properties": { "skill": { "const": "baoyu-cover-image" } }
        },
        "contributors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "prompt_source": { "type": "string", "enum": ["adapter", "external"] },
        "producer": { "type": "string", "minLength": 1 }
      },
      "required": ["baoyu_design"],
      "allOf": [
        {
          "if": {
            "properties": { "prompt_source": { "const": "external" } },
            "required": ["prompt_source"]
          },
          "then": { "required": ["producer"] }
        }
      ]
    },
    "infographic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intent": { "type": "string", "minLength": 1 },
        "layout": { "type": "string", "minLength": 1 },
        "style": { "type": "string", "minLength": 1 },
        "aspect": { "type": "string", "minLength": 1 },
        "design_notes": { "type": "string", "minLength": 1 },
        "baoyu_design": {
          "type": "object",
          "additionalProperties": true,
          "required": ["skill"],
          "properties": { "skill": { "const": "baoyu-infographic" } }
        },
        "contributors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "prompt_source": { "type": "string", "enum": ["adapter", "external"] },
        "producer": { "type": "string", "minLength": 1 }
      },
      "required": ["baoyu_design"],
      "allOf": [
        {
          "if": {
            "properties": { "prompt_source": { "const": "external" } },
            "required": ["prompt_source"]
          },
          "then": { "required": ["producer"] }
        }
      ]
    },
    "illustrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["slot"],
        "properties": {
          "slot": { "type": "integer", "minimum": 1 },
          "intent": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "style": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "baoyu_design": {
            "type": "object",
            "additionalProperties": true,
            "required": ["skill"],
            "properties": { "skill": { "const": "baoyu-article-illustrator" } }
          },
          "contributors": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "prompt_source": { "type": "string", "enum": ["adapter", "external"] },
          "producer": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "prompt_source": { "const": "external" } },
              "required": ["prompt_source"]
            },
            "then": { "required": ["producer"] }
          }
        ]
      }
    }
  }
}
