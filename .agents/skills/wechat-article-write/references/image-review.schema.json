{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wechat-article-write image-review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "visual_profile", "assets"],
  "properties": {
    "version": { "const": 1 },
    "visual_profile": { "type": "string", "minLength": 1 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset", "role", "sha256", "approved", "semantic_match", "legibility", "visible_text_ok", "text_density", "has_long_copy", "style_review", "reviewer_note"],
        "properties": {
          "asset": { "type": "string", "minLength": 1 },
          "role": { "enum": ["cover", "header", "body"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "approved": { "const": true },
          "semantic_match": { "const": true },
          "legibility": { "const": true },
          "visible_text_ok": { "const": true },
          "text_density": { "enum": ["none", "low", "medium"] },
          "has_long_copy": { "const": false },
          "style_review": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "bright": { "type": "boolean" },
              "high_saturation": { "type": "boolean" },
              "high_contrast": { "type": "boolean" },
              "clean_background": { "type": "boolean" },
              "crisp": { "type": "boolean" },
              "warm": { "type": "boolean" },
              "positive": { "type": "boolean" }
            }
          },
          "reviewer_note": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "visual_profile": { "const": "bright-vivid-warm" } },
        "required": ["visual_profile"]
      },
      "then": {
        "properties": {
          "assets": {
            "items": {
              "properties": {
                "style_review": {
                  "required": ["bright", "high_saturation", "high_contrast", "clean_background", "crisp", "warm", "positive"],
                  "properties": {
                    "bright": { "const": true },
                    "high_saturation": { "const": true },
                    "high_contrast": { "const": true },
                    "clean_background": { "const": true },
                    "crisp": { "const": true },
                    "warm": { "const": true },
                    "positive": { "const": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "visual_profile": { "const": "custom" } },
        "required": ["visual_profile"]
      },
      "then": {
        "properties": {
          "assets": {
            "items": {
              "properties": {
                "style_review": {
                  "required": ["visual_override_match"],
                  "properties": {
                    "visual_override_match": { "const": true }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
